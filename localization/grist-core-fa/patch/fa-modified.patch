+/**
+ * Language attributes for the <html> element of an app page: the language the user will get, its
+ * writing direction, and the calendar dates should use in it.
+ *
+ * The client works the same language out again (detectCurrentLang() in app/client/lib/localization
+ * has the first say, since it also knows the browser's language), but deciding here too means the
+ * page is laid out the right way round as it loads, instead of flipping after the bundle runs.
+ */
+export function getLanguageAttributes(req: express.Request, config: GristLoadConfig): string {
+  const supportedLngs = config.supportedLngs;
+  const detected = config.userLocale || req.language || "en";
+  // Mirror how the client picks a language, so the two agree: an exact (case-insensitive) match
+  // first, then the bare language subtag, and English if neither is offered.
+  const lower = String(detected).toLowerCase();
+  let lng: string;
+  if (supportedLngs && supportedLngs.length) {
+    lng = supportedLngs.find(s => s.toLowerCase() === lower) ??
+      supportedLngs.find(s => s.toLowerCase() === lower.split(/[-_]/)[0]) ?? "en";
+  } else {
+    // Pages served without a gristConfig -- the published form, custom-widget.html -- have no list
+    // to check against. req.language has already been resolved by i18next against the languages the
+    // server offers, so it can be trusted, apart from needing a second look as markup: keep only
+    // what can be a language tag.
+    const safe = (lower.match(/^[a-z]+/) || [""])[0].slice(0, 8);
+    lng = safe || "en";
+  }
+  const dir = languageDir(lng);
+  const attrs = [`lang="${lng}"`, `dir="${dir}"`];
+  if (shouldUseJalali(null, lng)) { attrs.push('data-calendar="jalali"'); }
+  return attrs.join(" ");
+}
